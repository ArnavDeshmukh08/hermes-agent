[Unit]
Description=Jack Reminder Scheduler
After=network.target hermes-gateway.service

[Service]
Type=simple
ExecStart=/home/hermes/.hermes/hermes-agent/venv/bin/python /home/hermes/.hermes/reminders/scheduler.py
WorkingDirectory=/home/hermes/.hermes
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
