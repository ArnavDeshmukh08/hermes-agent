[Unit]
Description=Jack Proactive Engine
After=network.target hermes-gateway.service

[Service]
Type=simple
ExecStart=/home/hermes/.hermes/hermes-agent/venv/bin/python /home/hermes/.hermes/proactive/scheduler.py
WorkingDirectory=/home/hermes/.hermes
Restart=always
RestartSec=30

[Install]
WantedBy=default.target
